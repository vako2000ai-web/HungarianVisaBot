# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram user id через запятую (узнать: @userinfobot)
ALLOWED_USER_IDS=
# Параметры записи (значения по умолчанию)
VFS_BASE_URL=https://services.vfsglobal.by/blr/ru/hun
VFS_CENTER=Hungary Visa Application Center, Minsk
VFS_CATEGORY=short term visa C
VFS_SUBCATEGORY=Short-Term VISA 90 days
# Интервал проверки, секунды (минимум 60)
CHECK_INTERVAL_SEC=180
# Каталог профиля браузера и файл состояния
PROFILE_DIR=./profile
STATE_FILE=./state.json
# 1 — показывать окно браузера (нужно, если Cloudflare просит ручной проверки)
HEADED=0
# Необязательно: путь к своему Chromium (иначе используется браузер Playwright)
CHROMIUM_PATH=
